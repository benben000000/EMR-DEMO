# ==============================================================================
# Global 1 OneTech - G1 Health EMR Environment Variables Template
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit your real .env file with production credentials to source control.
# ==============================================================================

# Neon Serverless PostgreSQL Connection String (from https://console.neon.tech)
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/<database>?sslmode=require

# Optional Unpooled / Direct Connection String
# DATABASE_URL_UNPOOLED=postgresql://<username>:<password>@<neon-unpooled-hostname>/<database>?sslmode=require

# Application Session Secret Key (Generate a random 64-character hex string)
SESSION_SECRET=your_secure_64_character_random_hex_secret_here

# Optional: Port for local development runner (defaults to 5000)
PORT=5000
