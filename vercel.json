{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/Personalization/(.*)",
      "destination": "/public/Personalization/$1"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/Account/Login",
      "destination": "/public/index.html"
    },
    {
      "source": "/login",
      "destination": "/public/index.html"
    },
    {
      "source": "/Account/Logout",
      "destination": "/public/index.html?logout=success"
    },
    {
      "source": "/logout",
      "destination": "/public/index.html?logout=success"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
